FROM alpine:3.22
ARG FRP_VERSION=0.71.0
ARG FRP_SHA256
ARG TARGETARCH
ARG TARGETVARIANT
RUN apk add --no-cache ca-certificates wget tar && \
    arch="$TARGETARCH" && \
    version="$FRP_VERSION" && checksum="$FRP_SHA256" && \
    if [ -z "$checksum" ] && [ "$version" = "0.71.0" ]; then \
      case "$arch" in \
        amd64) checksum=84f27e39f11169f7adcef8e8b70c9329de17747b1f14dad9fb95eef5682ea716 ;; \
        arm64) checksum=f33c293c275d8fc68c654b6fba8f10b2551d6463d09a9fc9cffb7227eae82266 ;; \
      esac; \
    fi && [ -n "$checksum" ] && \
    wget -q "https://github.com/fatedier/frp/releases/download/v${version}/frp_${version}_linux_${arch}.tar.gz" -O /tmp/frp.tgz && \
    echo "$checksum  /tmp/frp.tgz" | sha256sum -c - && \
    tar -xzf /tmp/frp.tgz -C /tmp && \
    cp "/tmp/frp_${version}_linux_${arch}/frpc" /usr/local/bin/frpc && \
    rm -rf /tmp/frp* && \
    addgroup -g 1000 podux && adduser -D -u 1000 -G podux podux && \
    mkdir -p /app/pb_data && chown -R podux:podux /app
WORKDIR /app
COPY deploy/frpc-entrypoint.sh /usr/local/bin/frpc-entrypoint
USER podux
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s CMD wget -q --spider http://127.0.0.1:7400/healthz || exit 1
ENTRYPOINT ["sh", "/usr/local/bin/frpc-entrypoint"]
